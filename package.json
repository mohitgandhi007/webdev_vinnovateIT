{
  "name": "pagepulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/src/server.js",
    "server:dev": "node --watch server/src/server.js",
    "server:start": "node server/src/server.js",
    "server:migrate": "node server/scripts/migrate.js",
    "server:clean": "node server/scripts/clean-storage.js",
    "server:seed": "node server/scripts/seed.js",
    "server:test": "node --test --test-force-exit server/tests/*.test.js",
    "demo:toggle": "node -e \"fetch('http://localhost:3001/api/demo/toggle',{method:'POST',headers:{'Accept':'application/json'}}).then(r=>r.json()).then(console.log)\""
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "fast-xml-parser": "^5.11.2",
    "pg": "^8.13.1",
    "playwright": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "pg-mem": "^3.0.4",
    "postcss": "^8.4.49",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.0"
  }
