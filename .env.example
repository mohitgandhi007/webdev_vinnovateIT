# ==============================================================================
# PagePulse — Digital Observatory & Website Change Monitoring Platform
# Production & Demonstration Environment Configuration
# ==============================================================================
# IMPORTANT:
# - Copy this file to .env: `cp .env.example .env`
# - Never commit real credentials, tokens, or passwords to version control.
# - In production containers, inject these variables via your cloud orchestrator
#   (e.g., Docker secrets, Kubernetes ConfigMaps/Secrets, Render, or AWS SSM).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Environment: 'production', 'development', or 'test'
NODE_ENV=production

# HTTP Port for Node.js Express API & static frontend server
PORT=3001

# Allowed CORS origins (comma-separated if multiple, e.g. https://pagepulse.app,https://admin.pagepulse.app)
# In unified single-container deployment, same-origin is used by default.
CORS_ORIGIN=http://localhost:5173

# Public application base URL (used in email notification links and webhooks)
APP_BASE_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Full PostgreSQL connection URI
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# If DATABASE_URL is not accessible, PagePulse automatically falls back to an
# in-memory relational PostgreSQL engine for zero-config demonstration mode.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pagepulse

# Connection pool sizing
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Database SSL configuration (set to 'true' or 'require' for AWS RDS / Supabase / Neon)
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# 3. SCREENSHOT STORAGE & RETENTION
# ------------------------------------------------------------------------------
# Storage driver: 'local' (persists to container disk or attached volume)
STORAGE_DRIVER=local

# Directory where full-page PNG screenshots and diff crops are persisted
# In Docker, map this directory to a persistent Docker named volume.
SCREENSHOTS_DIR=./uploads/screenshots

# Snapshot retention window (in days) before older non-baseline snapshots are pruned
SNAPSHOT_RETENTION_DAYS=30

# Minimum number of historical snapshots to preserve per target regardless of age
KEEP_MIN_SNAPSHOTS=5

# ------------------------------------------------------------------------------
# 4. GEMINI AI CHANGE INTELLIGENCE CONFIGURATION
# ------------------------------------------------------------------------------
# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# If empty or omitted, PagePulse automatically uses deterministic change intelligence
# with structured summaries and risk categorization without failing.
GEMINI_API_KEY=

# Gemini model identifier (recommended: gemini-2.5-flash or gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Maximum token budget for AI change summaries
GEMINI_MAX_TOKENS=1024

# ------------------------------------------------------------------------------
# 5. NOTIFICATION PROVIDERS CONFIGURATION
# ------------------------------------------------------------------------------
# Telegram Bot Integration (Optional)
# Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Discord Webhook Integration (Optional default webhook)
DISCORD_WEBHOOK_URL=

# Email / SMTP Delivery Settings (Optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
FROM_EMAIL=alerts@pagepulse.app

# Real-Time Web Push Notifications (VAPID)
# Generate via: `npx web-push generate-vapid-keys`
# (In development/test, PagePulse auto-generates ephemeral keys if omitted)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@pagepulse.app

# ------------------------------------------------------------------------------
# 6. APPLICATION SECURITY & SSRF SAFEGUARDS
# ------------------------------------------------------------------------------
# Allow local loopback fixtures (127.0.0.1, localhost) for demonstration testing
# CRITICAL: In strict public production deployments, set this to 'false'.
# Set to 'true' during local presentations or internal evaluation.
ALLOW_LOCAL_FIXTURES=false

# Browser navigation timeout in milliseconds (default: 30000ms = 30s)
NAVIGATION_TIMEOUT_MS=30000

# Rate limiter: Maximum API requests per minute per IP
RATE_LIMIT_MAX_PER_MINUTE=120
